+/* ioctls and kernel-control options must change the actual UART baud.
+ * Earlier versions reported 115200 regardless of request, which broke the
+ * iOS baud handoff without warning. The controller must already be ready
+ * to switch speeds before the host changes its divisor. */
+static int h4_set_termios(const struct h4_termios *req)
+{
+    unsigned baud = (unsigned)req->ospeed;
+    if (baud == 0U) baud = 115200U;
+    lck_mtx_lock(&h4_tx_lock);
+    if (!herolte_bt_hw_set_baud(baud)) {
+        lck_mtx_unlock(&h4_tx_lock);
+        return EINVAL;
+    }
+    h4.tio = *req;
+    h4.tio.cflag |= 0x30000ul;
+    h4.tio.ispeed = h4.tio.ospeed = baud;
+    lck_mtx_unlock(&h4_tx_lock);
+    return 0;
+}
+
