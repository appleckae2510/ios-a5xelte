+/* Exynos fractional-slot baud programming shared by bring-up and H4 ioctl.
+ * Only UART1 is touched.  Reject rates that cannot be represented within
+ * three percent by the verified 76.8 MHz parent clock. */
+static int
+hbt_uart_set_baud(vm_offset_t uart, unsigned baud)
+{
+    const uint32_t clock_hz = 76800000U;
+    if (baud < 9600U || baud > 4000000U) return 0;
+    uint32_t div16 = (clock_hz + baud / 2U) / baud;
+    if (div16 < 16U || div16 > (65536U * 16U)) return 0;
+    uint32_t actual = (clock_hz + div16 / 2U) / div16;
+    uint32_t error = actual > baud ? actual - baud : baud - actual;
+    if ((uint64_t)error * 100U > (uint64_t)baud * 3U) return 0;
+    uint32_t whole = div16 / 16U, frac = div16 % 16U;
+    hbt_wr(uart, HBT_UBRDIV, whole - 1U);
+    hbt_wr(uart, HBT_UDIVSLOT, hbt_slot_table[frac]);
+    printf("HEROLTE BT: UART1 baud requested=%u actual=%u div=%u slot=%#x\n",
+        baud, actual, whole - 1U, hbt_slot_table[frac]);
+    return 1;
+}
+
+int
+herolte_bt_hw_set_baud(unsigned baud)
+{
+    /* Do not expose uninitialized UART registers to userspace. */
+    if (!hbt_h4_uart) return 0;
+    return hbt_uart_set_baud(hbt_h4_uart, baud);
+}
+
