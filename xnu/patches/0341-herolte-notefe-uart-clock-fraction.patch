+static int
+hbt_uart1_enable(vm_offset_t cmu, vm_offset_t top, vm_offset_t uart)
+{
+    /* Preserve S-Boot's UART1 parent instead of unconditionally forcing
+     * oscclk. The Exynos mux status is one-hot for selection 0/1. */
+    uint32_t mux = hbt_rd(cmu, 0x0224);
+    uint32_t parent = (mux >> 12) & 1U;
+    uint32_t expected = 1U << (12U + parent);
+    uint32_t status = hbt_rd(cmu, 0x0624);
+    if ((status & (3U << 12)) != expected) {
