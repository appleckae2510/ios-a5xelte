-/* Exynos fractional-slot baud programming shared by bring-up and H4 ioctl.
- * Only UART1 is touched.  Reject rates that cannot be represented within
- * three percent by the verified 76.8 MHz parent clock. */
-static int
-hbt_uart_set_baud(vm_offset_t uart, unsigned baud)
-{
-    const uint32_t clock_hz = 76800000U;
-    if (baud < 9600U || baud > 4000000U) return 0;
-    uint32_t div16 = (clock_hz + baud / 2U) / baud;
-    if (div16 < 16U || div16 > (65536U * 16U)) return 0;
-    uint32_t actual = (clock_hz + div16 / 2U) / div16;
-    uint32_t error = actual > baud ? actual - baud : baud - actual;
-    if ((uint64_t)error * 100U > (uint64_t)baud * 3U) return 0;
-    uint32_t whole = div16 / 16U, frac = div16 % 16U;
-    hbt_wr(uart, HBT_UBRDIV, whole - 1U);
-    hbt_wr(uart, HBT_UDIVSLOT, hbt_slot_table[frac]);
-    printf("HEROLTE BT: UART1 baud requested=%u actual=%u div=%u slot=%#x\n",
-        baud, actual, whole - 1U, hbt_slot_table[frac]);
-    return 1;
-}
+/* Experimental Exynos8890 UART1 clock port, informed by
+ * egemengunel/ios-a5xelte gracerlte patches 0432-0433.
+ * Do not assume a fixed 76.8 MHz parent. On Note FE, the measured
+ * source is 132 MHz and UART1's register 0x2c is UFRACVAL (0..15),
+ * not the legacy Samsung UDIVSLOT bit-pattern table.
+ * Check the S7 boot log before using the result as a confirmed fact. */
+static uint32_t hbt_uart1_clock_hz;
+
+static uint32_t
+hbt_top_uart1_rate(vm_offset_t top)
+{
+    uint32_t con0 = hbt_rd(top, 0x100);
+    uint32_t m = (con0 >> 16) & 0x3ffU, p = (con0 >> 8) & 0x3fU, s = con0 & 7U;
+    uint64_t pll = p ? (26000000ULL * m) / ((uint64_t)p << s) : 0;
+    uint32_t bus_mux = hbt_rd(top, 0x200);
+    uint32_t bus_sclk = hbt_rd(top, 0x220);
+    uint32_t uart_mux = hbt_rd(top, 0x354);
+    uint32_t uart_div = hbt_rd(top, 0x4b4);
+    uint64_t rate = ((bus_mux >> 12) & 1U) ? pll : 26000000ULL;
+    if ((bus_sclk >> 12) & 1U) rate /= 2;
+    uint32_t sel = (uart_mux >> 12) & 3U;
+    if (sel == 1U) rate = 0; /* BUS1 rate unverified */
+    else if (sel >= 2U) rate = 26000000ULL;
+    rate /= (uart_div & 0xfU) + 1U;
+    printf("HEROLTE BT: TOP UART1 pll=%llu bus=%#x sclk=%#x src=%#x div=%#x rate=%llu Hz\n",
+        (unsigned long long)pll, bus_mux, bus_sclk, uart_mux, uart_div,
+        (unsigned long long)rate);
+    if (rate < 1843200ULL || rate > 1000000000ULL) return 0;
+    return (uint32_t)rate;
+}
+
+static int
+hbt_uart_set_baud(vm_offset_t uart, unsigned baud)
+{
+    const uint32_t clock_hz = hbt_uart1_clock_hz;
+    if (!clock_hz || baud < 9600U || baud > 4000000U) return 0;
+    uint32_t div16 = clock_hz / baud;
+    if (div16 < 16U || div16 > 1048576U) return 0;
+    uint32_t actual = clock_hz / div16;
+    uint32_t error = actual > baud ? actual - baud : baud - actual;
+    if ((uint64_t)error * 100U > (uint64_t)baud * 3U) return 0;
+    uint32_t whole = div16 / 16U, frac = div16 % 16U;
+    hbt_wr(uart, HBT_UBRDIV, whole - 1U);
+    hbt_wr(uart, HBT_UDIVSLOT, frac); /* UFRACVAL: direct fraction */
+    printf("HEROLTE BT: UART1 baud requested=%u actual=%u clock=%u div=%u frac=%u\n",
+        baud, actual, clock_hz, whole - 1U, frac);
+    return 1;
+}
 
 int
 herolte_bt_hw_set_baud(unsigned baud)
@@ -322,31 +343,24 @@
     return hbt_uart_set_baud(hbt_h4_uart, baud);
