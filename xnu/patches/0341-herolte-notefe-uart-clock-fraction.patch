+    hbt_uart1_clock_hz = parent ? hbt_top_uart1_rate(top) : 26000000U;
+    printf("HEROLTE BT: UART1 mux sel=%#x stat=%#x parent=%u clock=%u\n",
+        mux, status, parent, hbt_uart1_clock_hz);
+    if (!hbt_uart1_clock_hz) return 0;
