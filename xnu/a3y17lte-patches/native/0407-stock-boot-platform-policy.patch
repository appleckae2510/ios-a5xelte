+/* A CodeDirectory hash identifies its signed code-page hashes and
+ * entitlements. Runtime page verification remains with the normal XNU path.
+ * Names and locations within the root never substitute for this identity. */
+unsigned int
+a3_authorize_boot_flags(const uint8_t *cdhash, uint8_t hash_type,
+    unsigned long mount_flags, unsigned int cs_flags)
+{
+	if ((mount_flags & (MNT_ROOTFS | MNT_RDONLY)) != (MNT_ROOTFS | MNT_RDONLY)) {
+		return cs_flags;
+	}
+	const TrustCacheEntry2_t *entry = a3_measured_identity(cdhash);
+	if (entry == NULL || entry->hashType != hash_type) {
+		return cs_flags;
+	}
+	return cs_flags | CS_SIGNED | CS_PLATFORM_BINARY;
+}
