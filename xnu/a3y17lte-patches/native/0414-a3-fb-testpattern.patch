+/* One-shot test, after the console is muted. No scanout page-flip is used. */
+int testpat = 0;
+if (PE_parse_boot_argn("sweetfb_testpat", &testpat, sizeof(testpat)) &&
+    testpat == 1) {
+    if (!fConsolePaused) {
