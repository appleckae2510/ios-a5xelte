+/* A3 physical-panel diagnostic: no IOSurface, scaling or userland reads.
+ * Only test with a known-good panel mapping. Memory is BGRA (little endian)
+ * as expected by SWEET_FB_FORMAT_BGRA. The observed display is 720x1280.
+ */
+static void
+sweet_a3_fb_pattern(uintptr_t base, uint32_t w, uint32_t h, uint32_t pitch)
+{
+    static const uint32_t bars[8] = {
+        0xffffffffu, 0xffffff00u, 0xff00ffffu, 0xff00ff00u,
+        0xffff00ffu, 0xffff0000u, 0xff0000ffu, 0xff000000u
+    }; /* white, yellow, cyan, green, magenta, red, blue, black */
+    static const uint8_t digit[10][5] = {
+        {7,5,5,5,7}, {2,6,2,2,7}, {7,1,7,4,7}, {7,1,7,1,7},
+        {5,5,7,1,1}, {7,4,7,1,7}, {7,4,7,5,7}, {7,1,1,1,1},
+        {7,5,7,5,7}, {7,5,7,1,7}, {7,5,7,5,7}
+    };
+    if (!base || !w || !h || w > 4096u || h > 4096u ||
+        pitch < w * 4u || (pitch & 3u)) {
+        IOLog("A3 FBPAT: invalid panel geometry %ux%u pitch=%u\n", w, h, pitch);
+        return;
+    }
+    for (uint32_t y = 0; y < h; y++) {
+        volatile uint32_t *row = (volatile uint32_t *)(base + (uint64_t)y * pitch);
+        for (uint32_t x = 0; x < w; x++) {
+            uint32_t c = bars[(uint64_t)x * 8u / w];
+            if (y < 28u) c = 0xff101010u;
+            else if ((x % 64u) == 0u) c = 0xffffffffu;
+            if (y == h / 2u || y == h / 2u + 1u) c = 0xffffffffu;
+            row[x] = c;
+        }
+    }
+    for (uint32_t x = 0; x < w; x += 64u) {
+        unsigned n[3] = { (x / 100u) % 10u, (x / 10u) % 10u, x % 10u };
+        for (unsigned d = 0; d < 3u; d++) {
+            for (unsigned yy = 0; yy < 5u; yy++) {
+                for (unsigned xx = 0; xx < 3u; xx++) {
+                    if ((digit[n[d]][yy] & (4u >> xx)) == 0u) continue;
+                    for (unsigned dy = 0; dy < 2u; dy++) {
+                        for (unsigned dx = 0; dx < 2u; dx++) {
+                            uint32_t tx = x + 3u + d * 8u + xx * 2u + dx;
+                            uint32_t ty = 5u + yy * 3u + dy;
+                            if (tx < w && ty < h) {
+                                volatile uint32_t *row =
+                                    (volatile uint32_t *)(base + (uint64_t)ty * pitch);
+                                row[tx] = 0xffffffffu;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    IOLog("A3 FBPAT: DIRECT panel %ux%u pitch=%u (w*4=%u), source IOSurface bypassed\n",
+        w, h, pitch, w * 4u);
+}
