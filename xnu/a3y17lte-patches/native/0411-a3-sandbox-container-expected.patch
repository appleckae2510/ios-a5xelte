+/* iOS 16+ libsystem_sandbox op 0x43 asks whether sandbox containers
+ * are expected. The two fields passed here are user output pointers;
+ * success without zeroing them leaves undefined values for libSystem.
+ * Never fabricate a filesystem path or a sandbox extension token. */
 static int
-a3_stock_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+a3_stock_sandbox_container_expected(user_addr_t arg)
+{
+    user_addr_t out[2];
+    const uint64_t zero = 0;
+    if (arg == 0) {
+        return EINVAL;
+    }
+    int error = copyin(arg, out, sizeof(out));
+    if (error != 0) {
+        return error;
+    }
+    for (unsigned int i = 0; i < 2; i++) {
+        if (out[i] != 0) {
+            error = copyout(&zero, out[i], sizeof(zero));
+            if (error != 0) {
+                return error;
+            }
+        }
+    }
+    return 0;
+}
