diff --git a/bsd/dev/a3_hardware.inc b/bsd/dev/a3_hardware.inc
--- a/bsd/dev/a3_hardware.inc
+++ b/bsd/dev/a3_hardware.inc
@@ -79,12 +79,14 @@
